# ── Copy this to .env and fill in values ─────────────────────────────────────
# Local development defaults are already set in config.py, so this file
# is only needed when you want to override something.

# Your Vercel frontend URL (no trailing slash)
# Example: https://textshield-ai.vercel.app
FRONTEND_URL=http://localhost:3000

# Set to false in production (Dockerfile already sets this)
RELOAD=true

# Paths (change only if you moved files)
MODELS_DIR=app/models
DATASETS_DIR=datasets
